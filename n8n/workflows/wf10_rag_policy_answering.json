{
  "name": "WF-10: Grounded RAG Support & Human Approval Gate",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/1 * * * *"
            }
          ]
        }
      },
      "name": "Schedule Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id, d.customer_email, d.customer_query, d.rag_drafted_answer FROM support_drafts d WHERE d.approval_status = 'APPROVED' AND d.email_sent_at IS NULL FOR UPDATE SKIP LOCKED;"
      },
      "name": "Supabase PostgreSQL Node (FOR UPDATE SKIP LOCKED)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        480,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase-postgres-credentials",
          "name": "Supabase PostgreSQL Database"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.customer_email || $json.email || 'ops@airline.com' }}",
        "subject": "Official Airline Customer Support: Response to your inquiry",
        "emailType": "html",
        "message": "={{ $json.email_body || 'Automated Airline Notification from n8n Engine' }}"
      },
      "name": "Gmail Node (Scheduled Delivery)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        720,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "airline-gmail-credentials",
          "name": "Airline Gmail Account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Cron Trigger": {
      "main": [
        [
          {
            "node": "Supabase PostgreSQL Node (FOR UPDATE SKIP LOCKED)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase PostgreSQL Node (FOR UPDATE SKIP LOCKED)": {
      "main": [
        [
          {
            "node": "Gmail Node (Scheduled Delivery)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true,
    "description": "REQ-FRD-37, REQ-FRD-38, REQ-APP-43: Grounded fare rule answer + mandatory human approval gate before Gmail send."
  }
}