{
  "name": "WF-03: Scheduled Waitlist Seat Detection & Auto-Promotion",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/2 * * * *"
            }
          ]
        }
      },
      "name": "Schedule Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "BEGIN; SELECT * FROM flight_classes WHERE (total_seats - booked_seats - held_seats) > 0 FOR UPDATE; SELECT * FROM waitlist_entries WHERE status = 'PENDING' ORDER BY priority_score DESC, created_at ASC LIMIT 1 FOR UPDATE SKIP LOCKED; UPDATE waitlist_entries SET status = 'OFFERED', offered_at = NOW(), claim_deadline = NOW() + INTERVAL '2 hours'; COMMIT;"
      },
      "name": "Supabase PostgreSQL Node (FOR UPDATE SKIP LOCKED)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        480,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase-postgres-credentials",
          "name": "Supabase PostgreSQL Database"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.customer_email || $json.email || 'ops@airline.com' }}",
        "subject": "Seat Available Offer: Claim Your Seat on Flight {{ $json.flight_number }} within 2 Hours",
        "emailType": "html",
        "message": "={{ $json.email_body || 'Automated Airline Notification from n8n Engine' }}"
      },
      "name": "Gmail Node (Scheduled Delivery)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        720,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "airline-gmail-credentials",
          "name": "Airline Gmail Account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Cron Trigger": {
      "main": [
        [
          {
            "node": "Supabase PostgreSQL Node (FOR UPDATE SKIP LOCKED)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase PostgreSQL Node (FOR UPDATE SKIP LOCKED)": {
      "main": [
        [
          {
            "node": "Gmail Node (Scheduled Delivery)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true,
    "description": "REQ-WST-30, REQ-WST-32, REQ-SHD-48, REQ-SHD-50: Row-locking coordination between gate-agent and n8n."
  }
}