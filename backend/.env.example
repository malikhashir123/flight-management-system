# =============================================================================
# Flight Management System Environment Configuration
# =============================================================================

# Server Settings
APP_NAME=Flight Management System API
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=super-secret-fms-jwt-token-key-minimum-32-chars-length
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=*

# Supabase PostgreSQL Database URL
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres?ssl=require
# Fallback to local SQLite for tests: sqlite+aiosqlite:///./test_fms.db
DATABASE_URL=sqlite+aiosqlite:///./fms.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Business Logic Constraints
HOLD_TIMEOUT_MINUTES=10
DEFAULT_QUOTE_EXPIRY_MINUTES=15
WAITLIST_CLAIM_WINDOW_HOURS=2
INVOLUNTARY_CHANGE_MIN_HOURS=2
REFUND_ESCALATION_DAYS=3

# Email (Gmail SMTP / API)
GMAIL_SENDER_EMAIL=fms.system.alerts@gmail.com
GMAIL_APP_PASSWORD=your-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# Pinecone Vector DB
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=flight-policies
PINECONE_ENVIRONMENT=us-east-1

# LLM Inference (Groq / OpenAI)
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
